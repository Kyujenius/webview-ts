{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "jsx": "react-jsx",
    "paths": {
      "@webview-ts/shared": ["./packages/shared/src/index.ts"],
      "@webview-ts/core": ["./packages/core/src/index.ts"],
      "@webview-ts/react": ["./packages/clients/react/src/index.ts"],
      "@webview-ts/vue": ["./packages/clients/vue/src/index.ts"],
      "@webview-ts/react-native": ["./packages/hosts/react-native/src/index.ts"],
      "@webview-ts/devtools": ["./packages/devtools/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".turbo", "tests", "examples/react-native"]
}
