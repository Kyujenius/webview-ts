{
  "name": "@webview-ts/core",
  "version": "0.0.0",
  "description": "Web-side bridge engine with middleware pipeline",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kyujenius/webview-ts",
    "directory": "packages/core"
  },
  "keywords": [
    "webview",
    "bridge",
    "typescript",
    "react-native",
    "type-safe"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@webview-ts/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/ui": "catalog:",
    "happy-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
