{
  "name": "@webview-ts/core",
  "version": "0.0.0",
  "description": "Web-side bridge engine with middleware pipeline",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kyujenius/webview-ts",
    "directory": "packages/core"
  },
  "keywords": [
    "webview",
    "bridge",
    "typescript",
    "react-native",
    "type-safe"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@webview-ts/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/ui": "^1.6.0",
    "happy-dom": "^14.12.0",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
