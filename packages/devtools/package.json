{
  "name": "@webview-ts/devtools",
  "version": "0.1.0",
  "description": "Visual debugging tools for webview-ts communication",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kyujenius/webview-ts",
    "directory": "packages/devtools"
  },
  "keywords": [
    "webview",
    "bridge",
    "typescript",
    "react-native",
    "type-safe"
  ],
  "type": "module",
  "bin": {
    "devtools": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp build --config vite.config.dashboard.ts && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run --passWithNoTests",
    "test:coverage": "vp test run --coverage --passWithNoTests",
    "test:watch": "vp test",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "serve": "node dist/cli.mjs"
  },
  "dependencies": {
    "ws": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@webview-ts/shared": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-singlefile": "catalog:",
    "vite-plus": "catalog:"
  },
  "exports": {
    "./client": {
      "source": "./src/client/index.ts",
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "peerDependencies": {
    "@webview-ts/shared": "workspace:^"
  }
}
