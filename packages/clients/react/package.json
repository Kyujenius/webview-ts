{
  "name": "@webview-ts/react",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "description": "React hooks and provider for webview-ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kyujenius/webview-ts",
    "directory": "packages/clients/react"
  },
  "keywords": [
    "webview",
    "bridge",
    "typescript",
    "react-native",
    "type-safe"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@webview-ts/core": "workspace:*",
    "@webview-ts/shared": "workspace:*",
    "use-sync-external-store": "catalog:"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/use-sync-external-store": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
