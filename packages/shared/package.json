{
  "name": "@ts-bridge/shared",
  "version": "0.1.0",
  "description": "Shared types for ts-bridge — zero runtime dependencies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropics/ts-bridge",
    "directory": "packages/shared"
  },
  "keywords": ["webview", "bridge", "typescript", "react-native", "type-safe"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
