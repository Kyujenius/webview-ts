{
  "name": "@webview-ts/shared",
  "version": "0.1.0",
  "description": "Shared types for webview-ts — zero runtime dependencies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kyujenius/webview-ts",
    "directory": "packages/shared"
  },
  "keywords": [
    "webview",
    "bridge",
    "typescript",
    "react-native",
    "type-safe"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:watch": "vp test",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vite": "catalog:",
    "zod": "catalog:",
    "vite-plus": "catalog:"
  }
}
