{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vitest/globals"],
    "paths": {
      "@webview-ts/react-native": ["../packages/hosts/react-native/src"],
      "@webview-ts/core": ["../packages/core/src"],
      "@webview-ts/shared": ["../packages/shared/src"],
      "react-native": ["./__mocks__/react-native"],
      "react-native-webview": ["./__mocks__/react-native-webview"],
      "react": ["./__mocks__/react"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
